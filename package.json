{
  "name": "random-name-meimei",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run data:build && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:build": "python3 scripts/build-data.py",
